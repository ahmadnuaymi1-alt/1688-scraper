# ─────────────────────────────────────────────────────────────────────────────
# 1688 Scraper — environment configuration
#
# Copy this file to `.env.local` and fill in the values below.
# See SETUP.md for a full walkthrough — including the Higgsfield image CLI,
# which is configured SEPARATELY (it is NOT an env var here).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres — dedicated project) ── REQUIRED
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Scraping (Bright Data Web Unlocker) ── REQUIRED
BRIGHT_DATA_TOKEN=""
BRIGHT_DATA_ZONE="web_unlocker1"

# ── Anthropic Claude (titles, descriptions, variant cleanup, OCR) ── REQUIRED
ANTHROPIC_API_KEY=""

# ── Google Gemini (image OCR + hero/lifestyle vision QA) ── REQUIRED
# Both keys are read by the app. They can hold the SAME key, or two separate
# keys if you want to split quota between OCR and vision-QA calls.
GEMINI_API_KEY=""
GEMINI_VISION_API_KEY=""

# ── Supabase Storage (product imagery) ── REQUIRED
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_URL are normally the SAME value
# (https://PROJECT_REF.supabase.co). The NEXT_PUBLIC_ one is exposed to the browser.
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# ── Session (iron-session) ── REQUIRED
# Generate with: openssl rand -base64 48
SESSION_SECRET=""

# ── OpenAI (OPTIONAL) ──
# Only needed if you use the GPT-backed description / title TransformationRules.
# Leave blank to disable those rules; the rest of the app works without it.
OPENAI_API_KEY=""

# ── Shopify (OPTIONAL — for one-click auto-upload) ──
# Per-connection tokens are stored in the DB; these are fallback defaults only.
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_ADMIN_TOKEN=""

# ── Teemdrop (OPTIONAL — only for the /dimension-scanner skill) ──
# A bot-friendly 1688 mirror used to pull variant-specific dimension text.
TEEMDROP_EMAIL=""
TEEMDROP_PASSWORD=""

# ── Higgsfield image generation (OPTIONAL tuning) ──
# Caps concurrent Higgsfield generations across parallel agent-mode runs.
# Leave unset for normal single-product runs; set to 8 for large batches.
# HIGGSFIELD_MAX_INFLIGHT=8
